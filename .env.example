# Preference store
PREFERENCE_STORE_PATH=data\个人偏好.md

# Large capture state. Checkpoint is hidden state, not product output.
PREFERENCE_PROJECT_ROOT=.
PREFERENCE_CHECKPOINT_DIR=data\.capture-state

# Debug output writes intermediate files under data\.debug-capture.
PREFERENCE_CAPTURE_DEBUG=0
PREFERENCE_CANDIDATE_DIR=data\.debug-capture

# Formal cold-start capture should use recall-extract or semantic-extract.
# recall-only is for offline tests and recall debugging, not final output.
PREFERENCE_CAPTURE_MODE=recall-extract
PREFERENCE_CAPTURE_AGENT_RULES=0
PREFERENCE_CAPTURE_BATCH_SIZE=24
PREFERENCE_MODEL_BATCH_SIZE=6
PREFERENCE_CAPTURE_MAX_MINUTES=0
PREFERENCE_CAPTURE_MAX_RETRIES=3
PREFERENCE_CAPTURE_PROFILE_SAMPLE_LINES=1000

# Per model request timeout. This is request-level protection, not a whole-job cap.
PREFERENCE_MODEL_TIMEOUT=120
# Some Moonshot/Kimi models require temperature=1.
# PREFERENCE_MODEL_TEMPERATURE=1

# Optional cloud or local OpenAI-compatible model for semantic extraction.
PREFERENCE_MODEL_BACKEND=heuristic
# PREFERENCE_MODEL_BASE_URL=https://api.example.com/v1
# PREFERENCE_MODEL_API_KEY=replace-me
# PREFERENCE_MODEL_NAME=replace-me
#
# Local model example:
# PREFERENCE_MODEL_BACKEND=openai-compatible
# PREFERENCE_MODEL_BASE_URL=http://localhost:11434/v1
# PREFERENCE_MODEL_API_KEY=local
# PREFERENCE_MODEL_NAME=qwen2.5:7b

# Recall layer. `keyword` is cheap and strict after the quality gate.
# `multi` enables semantic + keyword + behavior + structure recall.
PREFERENCE_RECALL_STRATEGY=keyword
PREFERENCE_RECALL_BATCH_SIZE=64
PREFERENCE_RECALL_SEMANTIC_THRESHOLD=0.55
PREFERENCE_RECALL_FINAL_THRESHOLD=0.35
PREFERENCE_RECALL_BEHAVIOR_MIN_COUNT=3
PREFERENCE_RECALL_BEHAVIOR_MIN_SESSIONS=2

# Optional GLM embedding-3 cloud backend for semantic recall.
# Keep API keys in .env.local only.
# PREFERENCE_EMBEDDING_BACKEND=glm
# PREFERENCE_EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# PREFERENCE_EMBEDDING_API_KEY=replace-me
# PREFERENCE_EMBEDDING_MODEL=embedding-3
# PREFERENCE_EMBEDDING_DIMENSIONS=1024
# PREFERENCE_EMBEDDING_BATCH_SIZE=64
# PREFERENCE_EMBEDDING_TIMEOUT=90

# Injection/effectiveness layer. These are generated views and logs, not the
# official preference store.
PREFERENCE_INJECTION_DIR=data\.injection
PREFERENCE_INJECTION_MAX_RULES=30
PREFERENCE_FALLBACK_MAX_RULES=10
PREFERENCE_FEEDBACK_LOG=data\.feedback\feedback-log.jsonl
PREFERENCE_INCREMENTAL_STATE=data\.capture-state\incremental-scan.json

# Local manifesto panel. The server binds to localhost by default.
PREFERENCE_UI_HOST=127.0.0.1
PREFERENCE_UI_PORT=8080
PREFERENCE_UI_DIR=data\.ui
