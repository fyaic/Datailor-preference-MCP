# ============================================================================
# Datailor — Environment Variables
# ============================================================================
# This file lists all supported environment variables for Datailor.
# Copy it to .env.local and uncomment the lines you need to override.
#
# 本文档列出 Datailor 支持的所有环境变量。
# 复制到 .env.local，取消所需行的注释即可覆盖默认值。
# ============================================================================

# ----------------------------------------------------------------------------
# 1. STORAGE — Official preference store and project paths
#    存储层 — 官方偏好库与项目路径
# ----------------------------------------------------------------------------

# EN: Path to the official preference store. This is the single source of truth
#     for all extracted preferences, stored as a human-readable Markdown file.
# CN: 官方偏好库的存储路径。所有提取出的偏好都保存在这个 Markdown 文件中，
#     它是唯一的事实源，人类可读、可编辑、可带走。
# EN: By default Datailor uses the OS user data directory:
#     Windows: %APPDATA%\Datailor
#     macOS:   ~/Library/Application Support/Datailor
#     Linux:   ${XDG_DATA_HOME:-~/.local/share}/datailor
# CN: 默认写入操作系统用户数据目录，不依赖 git 仓库目录。
# DATAILOR_DATA_DIR=C:\Users\you\AppData\Roaming\Datailor
# PREFERENCE_STORE_PATH=C:\path\to\个人偏好.md

# EN: Root directory of the project being scanned. Used to resolve relative
#     paths during capture and incremental scan.
# CN: 被扫描项目的根目录。用于在捕获和增量扫描时解析相对路径。
PREFERENCE_PROJECT_ROOT=.

# EN: Directory for capture checkpoints (internal state, not user-facing output).
#     Enables resumable large-scale capture jobs.
# CN: 捕获断点状态存储目录（内部状态，非用户输出）。支持大规模捕获任务的断点恢复。
# PREFERENCE_CHECKPOINT_DIR=C:\path\to\.capture-state

# EN: Path to the incremental scan state file. Tracks which session files have
#     already been processed to avoid re-scanning on subsequent runs.
# CN: 增量扫描状态文件路径。记录已处理过的 session 文件，避免重复扫描。
# PREFERENCE_INCREMENTAL_STATE=C:\path\to\.capture-state\incremental-scan.json

# ----------------------------------------------------------------------------
# 2. CAPTURE — Preference extraction settings
#    捕获层 — 偏好提取配置
# ----------------------------------------------------------------------------

# EN: Capture mode. Controls how aggressively the system extracts preferences.
#     Options: recall-only | recall-extract | semantic-extract
#     - recall-only:     Fast, keyword-based filtering only. For debugging.
#     - recall-extract:  Default. Multi-strategy recall + LLM extraction.
#     - semantic-extract: Deepest. Semantic recall + full LLM refinement.
# CN: 捕获模式。控制系统提取偏好的深度。
#     recall-only      — 仅关键词召回，速度快，仅用于调试。
#     recall-extract   — 默认模式。多路召回 + LLM 精提。
#     semantic-extract — 最深模式。语义召回 + 完整 LLM 精炼。
PREFERENCE_CAPTURE_MODE=recall-extract

# EN: Whether to write captured preferences into AGENTS.md managed blocks
#     during capture. Set to 1 if you want immediate agent rule updates.
# CN: 是否在捕获完成后立即将提取的偏好写入 AGENTS.md 受管区块。
#     设为 1 可在捕获后立即更新 agent 规则。
PREFERENCE_CAPTURE_AGENT_RULES=0

# EN: Number of conversation turns to batch together before sending to the
#     extraction model. Larger = fewer API calls, more memory.
# CN: 每次发送给提取模型的对话轮数。值越大 API 调用越少，内存占用越高。
PREFERENCE_CAPTURE_BATCH_SIZE=24

# EN: Number of candidate preferences to send to the model in a single batch.
#     Separate from capture batch size; controls model-side throughput.
# CN: 单次发送给模型的候选偏好数量。与捕获批大小分开，控制模型侧吞吐量。
PREFERENCE_MODEL_BATCH_SIZE=6

# EN: Maximum duration (in minutes) for a capture job. 0 = no limit.
#     Prevents runaway jobs on very large history files.
# CN: 单次捕获任务的最大运行时长（分钟）。0 表示无限制。
#     防止在超大历史文件上出现失控任务。
PREFERENCE_CAPTURE_MAX_MINUTES=0

# EN: Maximum number of lines to read from a session file. 0 = read entire file.
#     Use this to cap memory usage on huge JSONL files.
# CN: 从单个 session 文件读取的最大行数。0 表示读取全部。
#     用于限制超大 JSONL 文件的内存占用。
PREFERENCE_CAPTURE_MAX_LINES=0

# EN: Maximum number of candidate preferences to extract per job.
#     Prevents flooding the store with low-quality candidates.
# CN: 单次任务提取的最大候选偏好数量。防止低质量候选淹没偏好库。
PREFERENCE_CAPTURE_MAX_CANDIDATES=0

# EN: Maximum retry attempts for a failed model request during capture.
# CN: 捕获过程中模型请求失败时的最大重试次数。
PREFERENCE_CAPTURE_MAX_RETRIES=3

# EN: Number of lines to sample when profiling a session file for structure
#     detection (e.g., JSONL vs plain text).
# CN: 分析 session 文件结构（如 JSONL 还是纯文本）时的采样行数。
PREFERENCE_CAPTURE_PROFILE_SAMPLE_LINES=1000

# EN: Enable debug output for capture. When 1, writes intermediate files
#     (recall candidates, model raw responses) to the candidate directory.
# CN: 是否启用捕获调试输出。设为 1 时，将召回候选和模型原始响应写入调试目录。
PREFERENCE_CAPTURE_DEBUG=0

# EN: Directory for capture debug output. Only used when CAPTURE_DEBUG=1.
# CN: 捕获调试输出目录。仅在 CAPTURE_DEBUG=1 时使用。
# PREFERENCE_CANDIDATE_DIR=C:\path\to\.debug-capture

# ----------------------------------------------------------------------------
# 3. MODEL — Backend for semantic extraction and executive summary
#    模型层 — 语义提取与画像摘要的后端
# ----------------------------------------------------------------------------

# EN: Model backend for preference extraction and summary generation.
#     Options: heuristic | openai-compatible
#     - heuristic:        Zero-dependency local backend. No API calls.
#     - openai-compatible: Cloud or local model via OpenAI-compatible API.
# CN: 偏好提取和摘要生成的模型后端。
#     heuristic          — 零依赖本地后端，不调用任何 API。
#     openai-compatible  — 通过兼容 OpenAI 的 API 调用云端或本地模型。
PREFERENCE_MODEL_BACKEND=heuristic

# EN: Base URL for the OpenAI-compatible API endpoint.
#     Required when MODEL_BACKEND=openai-compatible.
# CN: OpenAI 兼容 API 的基础 URL。仅在 MODEL_BACKEND=openai-compatible 时必填。
# PREFERENCE_MODEL_BASE_URL=https://api.example.com/v1

# EN: API key for the OpenAI-compatible endpoint.
#     Keep this in .env.local only — never commit keys to version control.
# CN: OpenAI 兼容 API 的密钥。仅保存在 .env.local 中，切勿提交到版本控制。
# PREFERENCE_MODEL_API_KEY=replace-me

# EN: Model name to use with the OpenAI-compatible backend.
# CN: OpenAI 兼容后端使用的模型名称。
# PREFERENCE_MODEL_NAME=replace-me

# EN: Request timeout in seconds for model API calls.
#     This is per-request protection, not a whole-job cap.
# CN: 模型 API 调用的请求超时时间（秒）。这是单次请求的保护，不是整个任务的上限。
PREFERENCE_MODEL_TIMEOUT=120

# EN: Sampling temperature for model generation. Some providers (e.g., Moonshot)
#     require temperature=1. Uncomment if your backend enforces this.
# CN: 模型生成的采样温度。部分服务商（如 Moonshot）要求 temperature=1，
#     若后端强制要求则取消注释。
# PREFERENCE_MODEL_TEMPERATURE=1

# ----------------------------------------------------------------------------
# 4. RECALL — Multi-strategy preference retrieval
#    召回层 — 多策略偏好检索
# ----------------------------------------------------------------------------

# EN: Recall strategy for matching preferences against incoming tasks.
#     Options: keyword | multi
#     - keyword: Cheap and strict. Uses keyword matching after quality gate.
#     - multi:   Enables semantic + keyword + behavior + structure fusion.
# CN: 偏好匹配任务的召回策略。
#     keyword — 廉价且严格，仅使用关键词匹配（经过质量门控）。
#     multi   — 启用语义 + 关键词 + 行为模式 + 对话结构的融合召回。
PREFERENCE_RECALL_STRATEGY=keyword

# EN: Batch size for recall processing. Number of preferences to evaluate
#     in a single batch during the recall phase.
# CN: 召回处理批大小。召回阶段单次评估的偏好数量。
PREFERENCE_RECALL_BATCH_SIZE=64

# EN: Minimum semantic similarity threshold for a candidate to pass the
#     semantic recall gate. Range: 0.0–1.0.
# CN: 语义召回门控的最小相似度阈值。范围 0.0–1.0。
PREFERENCE_RECALL_SEMANTIC_THRESHOLD=0.55

# EN: Final minimum score for a recalled preference to be sent to extraction.
#     After all recall paths are fused, candidates below this are dropped.
# CN: 召回偏好的最终最低得分，低于此值的候选不会进入精提阶段。
PREFERENCE_RECALL_FINAL_THRESHOLD=0.35

# EN: Minimum occurrence count for a behavior pattern to be considered a
#     stable preference (behavior recall path).
# CN: 行为模式召回路径中，一条模式被视为稳定偏好的最小出现次数。
PREFERENCE_RECALL_BEHAVIOR_MIN_COUNT=3

# EN: Minimum number of distinct sessions a behavior pattern must appear in
#     to be considered cross-session stable.
# CN: 行为模式必须出现在多少个不同 session 中，才被视为跨 session 稳定的偏好。
PREFERENCE_RECALL_BEHAVIOR_MIN_SESSIONS=2

# ----------------------------------------------------------------------------
# 5. EMBEDDING — Optional vector backend for semantic recall
#    嵌入层 — 语义召回的可选向量后端
# ----------------------------------------------------------------------------

# EN: Embedding backend for semantic similarity search.
#     Options: glm | openai-compatible | hash
#     - glm:              GLM Embedding-3 (cloud).
#     - openai-compatible: Any OpenAI-compatible embedding API.
#     - hash:             Zero-dependency fallback (no vectors).
# CN: 语义相似度搜索的嵌入后端。
#     glm              — GLM Embedding-3（云端）。
#     openai-compatible — 任意兼容 OpenAI 的嵌入 API。
#     hash             — 零依赖降级方案（无向量）。
# PREFERENCE_EMBEDDING_BACKEND=glm

# EN: Base URL for the embedding API. Required for glm or openai-compatible.
# CN: 嵌入 API 的基础 URL。使用 glm 或 openai-compatible 时必填。
# PREFERENCE_EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# EN: API key for the embedding backend. Keep in .env.local only.
# CN: 嵌入后端的 API 密钥。仅保存在 .env.local 中。
# PREFERENCE_EMBEDDING_API_KEY=replace-me

# EN: Embedding model name.
# CN: 嵌入模型名称。
# PREFERENCE_EMBEDDING_MODEL=embedding-3

# EN: Embedding vector dimensions. Must match the model's output size.
# CN: 嵌入向量维度。必须与模型的输出维度一致。
# PREFERENCE_EMBEDDING_DIMENSIONS=1024

# EN: Batch size for embedding API requests.
# CN: 嵌入 API 请求的批大小。
# PREFERENCE_EMBEDDING_BATCH_SIZE=64

# EN: Timeout in seconds for embedding API requests.
# CN: 嵌入 API 请求的超时时间（秒）。
# PREFERENCE_EMBEDDING_TIMEOUT=90

# ----------------------------------------------------------------------------
# 6. INJECTION — Preference effect layer (generated views, not the store)
#    注入层 — 偏好生效层（生成产物，非官方存储）
# ----------------------------------------------------------------------------

# EN: Directory for injection artifacts: static rules, session caches,
#     fallback rules, and snapshots.
# CN: 注入产物目录：存放静态规则、session 缓存、兜底规则和快照。
# PREFERENCE_INJECTION_DIR=C:\path\to\.injection

# EN: Maximum number of rules to inject into AGENTS.md managed blocks.
#     Prevents bloating agent context with too many rules.
# CN: 注入 AGENTS.md 受管区块的最大规则数量。防止 agent 上下文膨胀。
PREFERENCE_INJECTION_MAX_RULES=30

# EN: Maximum number of fallback rules to keep for offline/MCP-unavailable
#     scenarios.
# CN: MCP 不可用时本地兜底规则的最大保留数量。
PREFERENCE_FALLBACK_MAX_RULES=10

# EN: Path to the feedback audit log (JSONL). Records Confirm / Reject /
#     Correct actions for preference evolution analysis.
# CN: 反馈审计日志路径（JSONL）。记录 Confirm / Reject / Correct 操作，
#     用于偏好演化分析。
# PREFERENCE_FEEDBACK_LOG=C:\path\to\.feedback\feedback-log.jsonl

# EN: Path to the injection log (JSONL). Records every preference injection
#     event: which hook, which preferences matched, what instruction was sent.
# CN: 注入日志路径（JSONL）。记录每次偏好注入事件：哪个 hook、命中了哪些偏好、
#     发送了什么指令。
# PREFERENCE_INJECTION_LOG=C:\path\to\.injection-log.jsonl

# ----------------------------------------------------------------------------
# 7. EXECUTIVE SUMMARY — Derived user portrait
#    画像摘要 — 派生的用户画像
# ----------------------------------------------------------------------------

# EN: Whether to enable automatic Executive Summary generation after each
#     preference capture or update. The summary is a derived view, not the
#     official store.
# CN: 是否在每次偏好捕获或更新后自动生成 Executive Summary（画像摘要）。
#     摘要是派生视图，非官方存储。
PREFERENCE_EXECUTIVE_SUMMARY_ENABLED=1

# EN: Path to the generated Executive Summary (Markdown).
# CN: 生成的画像摘要存储路径（Markdown）。
# PREFERENCE_EXECUTIVE_SUMMARY_PATH=C:\path\to\.summary\executive-summary.md

# ----------------------------------------------------------------------------
# 8. SNAPSHOT — Automatic backup before store modifications
#    快照 — 修改前的自动备份
# ----------------------------------------------------------------------------

# EN: Whether to enable automatic snapshots before overwriting the preference
#     store. Strongly recommended for production use.
# CN: 是否在覆盖偏好库前启用自动快照。生产环境强烈建议开启。
PREFERENCE_SNAPSHOT_ENABLED=1

# EN: Directory for automatic snapshots. Each snapshot is a full Markdown
#     copy of the store at a point in time.
# CN: 自动快照存储目录。每个快照是某一时刻偏好库的完整 Markdown 副本。
# PREFERENCE_SNAPSHOT_DIR=C:\path\to\.snapshots

# EN: Maximum number of snapshots to retain. Older snapshots are pruned
#     automatically when this limit is exceeded.
# CN: 保留的最大快照数量。超出此限制时自动清理最旧的快照。
PREFERENCE_SNAPSHOT_MAX=50

# ----------------------------------------------------------------------------
# 9. UI — Local Manifesto panel
#    UI — 本地 Manifesto 面板
# ----------------------------------------------------------------------------

# EN: Host address for the local Manifesto UI server. Defaults to localhost
#     for security — the panel is not exposed to the network.
# CN: 本地 Manifesto UI 服务器的绑定地址。默认 localhost 以确保安全，
#     面板不会暴露到网络。
PREFERENCE_UI_HOST=127.0.0.1

# EN: Port for the local Manifesto UI server.
# CN: 本地 Manifesto UI 服务器的端口。
PREFERENCE_UI_PORT=8080

# EN: Directory for UI settings and event state.
# CN: UI 设置与事件状态的存储目录。
# PREFERENCE_UI_DIR=C:\path\to\.ui

# ----------------------------------------------------------------------------
# 10. AUTO-DISCOVERY — Cold-start agent history detection
#     自动发现 — 冷启动 agent 历史检测
# ----------------------------------------------------------------------------

# EN: Whether to allow automatic cold-start discovery of agent history sources
#     when MCP tools are called without an explicit source_path.
# CN: 当 MCP 工具调用未提供显式 source_path 时，是否允许自动冷启动发现
#     本地 agent 历史源。
PREFERENCE_AUTO_DISCOVERY=1

# EN: Max files for auto-discovery scan (0 = unlimited).
# CN: 自动发现扫描的最大文件数（0 = 不限制）。
# PREFERENCE_AUTO_DISCOVERY_MAX_FILES=0

# EN: Max minutes for auto-discovery scan (0 = unlimited).
# CN: 自动发现扫描的最大运行时长（分钟）。
# PREFERENCE_AUTO_DISCOVERY_MAX_MINUTES=0

# EN: Dry-run auto-discovery (1 = analyze only, do not write store).
# CN: 自动发现演练模式（1 = 仅分析，不写入偏好库）。
# PREFERENCE_AUTO_DISCOVERY_DRY_RUN=0

# EN: Default caller agent name. Used by CLI and MCP to set the agent context
#     when no explicit --agent is provided.
# CN: 默认调用方 agent 名称。CLI 和 MCP 在未显式传入 --agent 时使用此值。
# PREFERENCE_CALLER_AGENT=codex

# EN: Alternative data directory override (fallback for DATAILOR_DATA_DIR).
# CN: 备选数据目录覆盖（DATAILOR_DATA_DIR 的备用变量）。
# PREFERENCE_DATA_DIR=C:\path\to\Datailor

# EN: Directory for session-level hook state and temporary caches.
# CN: Session 级 hook 状态与临时缓存目录。
# PREFERENCE_HOOKS_DIR=C:\path\to\.hooks

# EN: Path to the embedding vector cache file (JSON).
# CN: 嵌入向量缓存文件路径（JSON）。
# PREFERENCE_EMBEDDING_CACHE_PATH=C:\path\to\.capture-state\embedding-cache.json
